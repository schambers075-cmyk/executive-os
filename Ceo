logger = logging.getLogger("CEOAgent")


class PermissionLevel(str, enum.Enum):
    LEVEL_1_AUTONOMOUS = "LEVEL_1_AUTONOMOUS"
    LEVEL_2_CONDITIONAL = "LEVEL_2_CONDITIONAL"
    LEVEL_3_RESTRICTED = "LEVEL_3_RESTRICTED"


class ApprovalDecision(str, enum.Enum):
    NOT_REQUIRED = "NOT_REQUIRED"
    APPROVED = "APPROVED"
    DENIED = "DENIED"
    PENDING = "PENDING"
    UNAVAILABLE = "UNAVAILABLE"
    PROHIBITED = "PROHIBITED"


class Domain(str, enum.Enum):
    FINANCIAL = "FINANCIAL"
    STAFFING = "STAFFING"
    OPERATIONS = "OPERATIONS"
    LEGAL = "LEGAL"
    COMMUNICATIONS = "COMMUNICATIONS"


@dataclass(frozen=True)
class ActionRequest:
    action_id: str
    domain: Domain
    action_type: str
    parameters: Dict[str, Any]
    timestamp: datetime = field(
        default_factory=lambda: datetime.now(timezone.utc)
    )


@dataclass(frozen=True)
class AgentResponse:
    action_id: str
    permission_level: PermissionLevel
    approval_decision: ApprovalDecision
    status: str
    payload: Dict[str, Any]
    requires_human_approval: bool
    audit_notes: str


ApprovalWebhook = Union[
    Callable[[Dict[str, Any]], bool],
    Callable[[Dict[str, Any]], Awaitable[bool]],
]


class ApprovalWebhookError(Exception):
    """Base exception for approval webhook failures."""


class ApprovalWebhookTimeout(ApprovalWebhookError):
    """Raised when all approval attempts time out."""


class ApprovalWebhookUnavailable(ApprovalWebhookError):
    """Raised when retryable webhook failures are exhausted."""


class InvalidApprovalResponse(ApprovalWebhookError):
    """Raised when the webhook violates its response contract."""


class ActionIdConflictError(Exception):
    """Raised when an action ID is reused with different content."""


class BoundedOrderedDict(OrderedDict):
    """Thread-safe bounded dictionary to prevent unbounded in-memory expansion."""
    def __init__(self, maxsize: int = 10000, *args, **kwargs):
        self.maxsize = maxsize
        super().__init__(*args, **kwargs)

    def __setitem__(self, key, value):
        super().__setitem__(key, value)
        if len(self) > self.maxsize:
            self.popitem(last=False)


class CEOAgent:
    """
    Policy-enforcement agent with fail-closed approvals.

    Key Guarantees:
    - Autonomous actions are authorized only after strict policy validation.
    - Conditional actions require an explicit boolean True from webhook.
    - False is a final denial and is not retried.
    - Missing webhooks, timeouts, exceptions, and malformed responses fail closed.
    - Restricted and unknown actions are blocked.
    - All attempts for one operation share the same idempotency key.
    - Concurrent identical requests share one in-flight processing task.
    - Reusing an action ID with different request content is blocked (blocked_conflict).
    - In-memory data structures are bounded to prevent memory leaks.
    """

    FINAL_STATUSES: Set[str] = {
        "approved",
        "denied",
        "blocked",
        "authorized",
        "blocked_conflict",
    }

    def __init__(
        self,
        approval_webhook: Optional[ApprovalWebhook] = None,
        approval_timeout_seconds: float = 5.0,
        approval_max_attempts: int = 3,
        approval_retry_base_delay_seconds: float = 0.5,
        approval_retry_max_delay_seconds: float = 4.0,
        max_cache_entries: int = 10000,
    ):
        self._validate_configuration(
            approval_timeout_seconds=approval_timeout_seconds,
            approval_max_attempts=approval_max_attempts,
            approval_retry_base_delay_seconds=approval_retry_base_delay_seconds,
            approval_retry_max_delay_seconds=approval_retry_max_delay_seconds,
        )

        self.approval_webhook = approval_webhook
        self.approval_timeout_seconds = float(approval_timeout_seconds)
        self.approval_max_attempts = int(approval_max_attempts)
        self.approval_retry_base_delay_seconds = float(approval_retry_base_delay_seconds)
        self.approval_retry_max_delay_seconds = float(approval_retry_max_delay_seconds)

        self.audit_log: List[AgentResponse] = []

        # Shared request-processing state protection
        self._state_lock = asyncio.Lock()

        # Deduplication task map
        self._inflight_requests: Dict[str, asyncio.Task[AgentResponse]] = {}

        # Bounded state registries
        self._completed_responses = BoundedOrderedDict(maxsize=max_cache_entries)
        self._action_fingerprints = BoundedOrderedDict(maxsize=max_cache_entries)

        self.rules = {
            "financial": {
