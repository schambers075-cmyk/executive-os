                },
                "conditional": {
                    "draft_vendor_payout_schedules",
                    "prepare_operational_budgets",
                    "propose_scope_change_fees",
                    "propose_rate_increases",
                },
                "restricted": {
                    "approve_wire_transfers",
                    "approve_bank_payouts",
                    "open_credit_lines",
                    "close_credit_lines",
                    "open_merchant_accounts",
                    "close_merchant_accounts",
                    "modify_core_pricing_models",
                },
                "amount_caps": {
                    "reconcile_logged_operational_receipts": 250.00,
                },
            },
            "staffing": {
                "autonomous": {
                    "screen_applications",
                    "auto_schedule_interviews",
                    "send_onboarding_materials",
                    "send_onboarding_checklists",
                },
                "conditional": {
                    "draft_disciplinary_notices",
                    "draft_warnings",
                    "prepare_compensation_adjustments",
                    "compile_performance_review_scorecards",
                },
                "restricted": {
                    "final_hiring_decisions",
                    "issue_termination_notices",
                    "issue_severance_agreements",
                    "modify_payroll",
                    "modify_tax_withholding",
                    "modify_benefits",
                    "sign_offer_letters",
                    "terminate_employee",
                },
                "amount_caps": {},
            },
            "operations": {
                "autonomous": {
                    "assign_daily_task_routes",
                    "assign_work_orders",
                    "trigger_inventory_reorders",
                    "log_quality_audit_scores",
                },
                "conditional": {
                    "update_sops",
                    "reassign_service_territory_routes",
